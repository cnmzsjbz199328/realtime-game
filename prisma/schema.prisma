datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SavedGame {
  id          String   @id @default(uuid())
  title       String
  description String
  code        String   @db.Text
  likes       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([likes(sort: Desc)])
  @@index([createdAt])
}

// --- Evolution Layer Models ---

enum SystemPromptRole {
  DIRECTOR
  ENGINEER
  FIXER
  REMIXER
  ARCHITECT
}

model SystemPrompt {
  id          String   @id @default(uuid())
  role        SystemPromptRole
  content     String   @db.Text
  version     Int      @default(1)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skeleton {
  id          String   @id // e.g., 'breakout_paddle'
  description String   // 简短游戏类型描述（用于 Director 分类）
  details     String   @db.Text // 详细游戏指导和 System Prompt（用于 Engineer 生成）
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IssueRecord {
  id          String   @id @default(uuid())
  gameId      String
  errorType   String   // 'SYNTAX', 'RUNTIME', 'LOGIC'
  errorMsg    String   @db.Text
  fixPrompt   String?  @db.Text
  skeletonId  String?
  status      String   @default("PENDING") // 'PENDING', 'PROCESSED'
  createdAt   DateTime @default(now())

  @@index([gameId])
  @@index([status])
}

model OptimizationRecord {
  id          String   @id @default(uuid())
  gameId      String
  userRequest String   @db.Text
  diff        String?  @db.Text
  skeletonId  String?
  status      String   @default("PENDING") // 'PENDING', 'PROCESSED'
  createdAt   DateTime @default(now())

  @@index([gameId])
  @@index([status])
}
