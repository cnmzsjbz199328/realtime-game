datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SavedGame {
  id          String   @id @default(uuid())
  title       String
  description String
  code        String   @db.Text
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
}
